{
  "name": "proof_neighborhood",
  "description": "Synthetic two-scene physical-radius and named-category proof.",
  "steps": [
    {"do": "home.load_prepared_data", "with": {"stem": "recipe_fixture"}},
    {
      "do": "home.analysis",
      "with": {"repeat_column": "all data", "key_strings": []},
      "steps": [
        {
          "do": "ifp.neighborhood",
          "steps": [
            {"do": "ifp.region_average", "with": {"radius_um": 1.3}},
            {"do": "ifp.neighborhood_count", "with": {
              "totals": "n", "radii_um": [1.3], "column": "Primary Celltype",
              "center_keys": [], "min_neighbors": 0
            }},
            {"do": "ifp.neighborhood_entropy", "with": {
              "radii_um": [1.3], "column": "Primary Celltype", "center_keys": []
            }},
            {"do": "ifp.nearest_type", "with": {
              "targets": [{"column": "Primary Celltype", "values": ["immune"]}]
            }}
          ]
        }
      ]
    }
  ]
}
